{
  "name": "hacklab",
  "version": "0.10.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hacklabubu/cli.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hacklab": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/og": "^0.11.1",
    "chalk": "^5.6.2",
    "posthog-node": "^5.45.2",
    "satori": "^0.26.0",
    "sql.js": "^1.14.1",
    "string-width": "^7.2.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@types/node": "^25.5.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
